# Rust
/target

# Nix
.direnv/

# Artifacts
./*.xml
*.json
parsed/

# Committed test fixtures. `*.json` above is for data dumps, but the fixtures
# under tests/ are the real data the suite runs against and must be tracked.
# Without this a new fixture is skipped by `git add` in silence, and the tests
# only fail once CI checks out a tree that never had it.
!tests/test_data/processed/*.json
# The two cached CourtListener responses for Obergefell v. Hodges, which are the
# real record a court opinion is stored from (#129). The opinion and its cluster
# are two requests, and the filing date is only on the cluster.
!tests/test_data/courtlistener/*.json

# Main directories for dumping data while testing
usc_data/
bill_data/

# Debug driver scripts
src/main.rs

# Claude Code Users
.claude/

# Python bindings
*.so
*.pyc

# Unzipped test files
tests/test_data/bills/
tests/test_data/usc/

# folder to dump test scripts
hacks/

plans/

# Generated sqlite datasets
*.sqlite
